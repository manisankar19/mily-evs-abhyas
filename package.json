{
  "name": "mily-evs-abhyas",
  "version": "1.0.0",
  "private": true,
  "description": "Chapter-wise EVS (The World Around Us) practice papers for Class 4 — static, single-file site.",
  "scripts": {
    "validate": "node validate.js",
    "build": "node build.js",
    "dev": "node build.js && node dev-server.js",
    "pack": "node build.js --minify && node pack.js",
    "fidelity": "node scripts/fidelity.js",
    "review-sheets": "node scripts/review-sheet.js --all",
    "test:fixtures": "node tests/fixtures.js && node tests/fidelity-fixtures.js",
    "check:existing": "node scripts/hash-existing.js --check",
    "test:assets": "node tests/assets.js",
    "test:brief": "node tests/brief.js",
    "test:e2e": "node tests/run-e2e.js",
    "test:deploy": "node tests/deploy-config.js",
    "test:build": "node tests/build-assets.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
